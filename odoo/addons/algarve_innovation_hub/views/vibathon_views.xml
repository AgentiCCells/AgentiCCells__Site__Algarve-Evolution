<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aih_vibathon_list" model="ir.ui.view">
        <field name="name">aih.vibathon.list</field>
        <field name="model">aih.vibathon</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="town"/>
                <field name="registrations"/>
                <field name="is_published"/>
                <field name="simulated"/>
            </list>
        </field>
    </record>
    <record id="aih_vibathon_form" model="ir.ui.view">
        <field name="name">aih.vibathon.form</field>
        <field name="model">aih.vibathon</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="venue"/>
                            <field name="town"/>
                            <field name="registrations"/>
                            <field name="event_id"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="simulated"/>
                            <field name="feed_key"/>
                            <field name="source_url" widget="url"/>
                        </group>
                    </group>
                    <field name="summary"/>
                    <notebook>
                        <page string="Projects">
                            <field name="project_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="team_ids" widget="many2many_tags"/>
                                    <field name="prize"/>
                                    <field name="score_total"/>
                                    <field name="next_step"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mentors and jury">
                            <field name="mentor_ids" widget="many2many_tags"/>
                            <field name="jury_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="partner_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Participants (private)">
                            <field name="participant_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="role"/>
                                    <field name="partner_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Next steps">
                            <field name="next_steps" placeholder="One next step per line"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="aih_vibathon_action" model="ir.actions.act_window">
        <field name="name">Vibathons</field>
        <field name="res_model">aih.vibathon</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="aih_project_list" model="ir.ui.view">
        <field name="name">aih.project.list</field>
        <field name="model">aih.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="vibathon_id"/>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="prize"/>
                <field name="score_total"/>
                <field name="next_step"/>
                <field name="is_published"/>
                <field name="simulated"/>
            </list>
        </field>
    </record>
    <record id="aih_project_form" model="ir.ui.view">
        <field name="name">aih.project.form</field>
        <field name="model">aih.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="vibathon_id"/>
                            <field name="team_ids" widget="many2many_tags"/>
                            <field name="mentor_id"/>
                            <field name="prize"/>
                            <field name="next_step"/>
                        </group>
                        <group>
                            <field name="score_total"/>
                            <field name="is_published"/>
                            <field name="simulated"/>
                            <field name="feed_key"/>
                        </group>
                    </group>
                    <field name="summary"/>
                    <separator string="Jury scores (private)"/>
                    <field name="score_ids">
                        <list editable="bottom">
                            <field name="juror"/>
                            <field name="criterion"/>
                            <field name="score"/>
                            <field name="comment"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="aih_project_action" model="ir.actions.act_window">
        <field name="name">Vibathon projects</field>
        <field name="res_model">aih.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
